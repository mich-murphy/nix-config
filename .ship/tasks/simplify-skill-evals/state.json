      "path": "/Users/mm/dev/nix-config/.ship/tasks/simplify-skill-evals/review-1.json",
      "hash": "sha256:936a5bb67da72fb9a8fb2de831c78e80b49dc8d64f888a3c9f64575e7092bb6e",
      "candidate_hash": "sha256:7b14c9c2b56a309bee94db71c434c55600a8d571b0fec59681d3b409da058d40",
      "verdict": "changes-required",
      "findings": [
        {
          "id": "R1",
          "severity": "blocking",
          "category": "correctness",
          "location": "config/agents/eval_identity.py:13",
          "finding": "Evaluation identity omits the unique execution ID, evaluator version, evaluated skill/package hash, and specialized evaluator assets.",
          "evidence": "DEFINITION_FILES contains only cases.json, routing-cases.json, and routes.json. build_identity hashes those files and selected controls, then adds the random execution_id only after the key has already been computed.",
          "consequence": "Separate executions and behavior-affecting changes can share one key, overwrite spools, or join unrelated evidence.",
          "route": "tdd"
        },
        {
          "id": "R2",
          "severity": "blocking",
          "category": "correctness",
          "location": "config/agents/eval_compare.py:103",
          "finding": "Strict release does not prove that results are the complete declared matrix or that the comparison belongs to the candidate.",
          "evidence": "complete_valid_matrix only checks item validity; release eligibility trusts configuration and separately supplied comparison/publication artifacts are not identity-bound.",
          "consequence": "A valid subset or another candidate's comparison can satisfy strict release.",
          "route": "tdd"
        },
        {
          "id": "R3",
          "severity": "blocking",
          "category": "correctness",
          "location": "config/agents/telemetry/publish_evals.py:145",
          "finding": "Publication retries do not detect conflicting result content for an existing evaluation identity.",
          "evidence": "Assessments are accepted by name and summary reuse checks only definition_hashes, not the safe result document or values.",
          "consequence": "Changed content can reuse stale assessments and summaries while reporting published.",
          "route": "tdd"
        },
        {
          "id": "R4",
          "severity": "blocking",
          "category": "correctness",
          "location": "config/agents/skills/skill-development/evals/run-evals.py:623",
          "finding": "The skill-development adapter overwrites its evaluation identity with a future-label tuple.",
          "evidence": "identity is created as a dictionary, reassigned from futures[future], and then used as both tuple and dictionary.",
          "consequence": "Pending runs and exception handling fail, while exported runs carry malformed identity.",
          "route": "tdd"
        },
        {
          "id": "R5",
          "severity": "blocking",
          "category": "requirements",
          "location": "config/agents/eval_cli.py:108",
          "finding": "Neo cannot complete the central strict-release workflow.",
          "evidence": "The central adapter never passes required full-cost acknowledgement and Neo results have no common publication traces, so evidence remains pending with nothing retryable.",
          "consequence": "Neo cannot run and publish the approved full specialized matrix through the central CLI.",
          "route": "tdd"
        },
        {
          "id": "R6",
          "severity": "blocking",
          "category": "security",
          "location": "config/agents/eval_publication.py:70",
          "finding": "Metadata-only publication does not recursively exclude forbidden content.",
          "evidence": "Nested dictionaries inside allowed fields are truncated but their keys are not filtered; assessment rationale includes blocking failure values.",
          "consequence": "Nested prompt, response, environment, credential, source, or tool content can reach MLflow.",
          "route": "tdd"
        },
        {
          "id": "R7",
          "severity": "blocking",
          "category": "operations",
          "location": "docker/ai-observability/retention.py:121",
          "finding": "Retention does not paginate MLflow runs or traces and requests 1,000 traces despite a 500-result trace page maximum.",
          "evidence": "Each search is called once and no page token is consumed; pure selection tests do not cover enumeration.",
          "consequence": "Retention can fail or make a deletion decision from a partial evidence set, violating global fail-safe behavior.",
          "route": "tdd"
        }
      ],
