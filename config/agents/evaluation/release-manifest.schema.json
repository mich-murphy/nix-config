{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/app-agent/release-manifest.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "skill",
    "git_revision",
    "definition_hashes",
    "evaluation_identity",
    "mlflow",
    "owner_decision",
    "owner",
    "limitations",
    "supersedes",
    "protection",
    "release_eligible"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "skill": {"type": "string", "minLength": 1},
    "git_revision": {"type": "string", "minLength": 1},
    "definition_hashes": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "evaluation_identity": {"type": ["string", "null"]},
    "mlflow": {"type": "object"},
    "owner_decision": {"enum": ["defer", "adopt", "reject", "restrict"]},
    "owner": {"type": "string", "minLength": 1},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "supersedes": {"type": ["string", "null"]},
    "protection": {"type": "object"},
    "release_eligible": {"type": "boolean"}
  },
  "additionalProperties": true
}
