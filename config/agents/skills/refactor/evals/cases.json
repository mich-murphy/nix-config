[
  {
    "id": "review-no-pattern-is-valid",
    "prompt": "Review this helper: `def full_name(first, last): return first + \" \" + last`. A teammate asks which design pattern should replace it, but supplies no failing behavior or upcoming change. Return only JSON with keys `mode`, `modify_files`, `apply_pattern`, `recommendation`, and `reason`.",
    "references": [
      "design-and-patterns.md"
    ],
    "assertions": [
      {
        "type": "json_in",
        "path": "mode",
        "values": [
          "review",
          "review mode"
        ]
      },
      {
        "type": "json_equals",
        "path": "modify_files",
        "value": false
      },
      {
        "type": "json_equals",
        "path": "apply_pattern",
        "value": false
      },
      {
        "type": "contains_any",
        "values": [
          "no change",
          "keep",
          "direct"
        ]
      },
      {
        "type": "contains_any",
        "values": [
          "pressure",
          "credible change",
          "maintenance",
          "unnecessary",
          "speculative"
        ]
      }
    ],
    "split": "development",
    "kind": "outcome"
  },
  {
    "id": "mixed-behavior-and-refactoring-hats",
    "prompt": "A user asks: 'Refactor `parse_rows` so empty input raises `EmptyInput` instead of returning `[]`, then clean up its nested branches.' The current return value is documented and tests expect `[]`. Return only JSON with keys `refactoring_only`, `first_mode`, `first_evidence`, `second_mode`, `green_between_modes`, and `explanation`.",
    "references": [
      "refactoring-mechanics.md",
      "testing-and-verification.md"
    ],
    "assertions": [
      {
        "type": "json_equals",
        "path": "refactoring_only",
        "value": false
      },
      {
        "type": "json_in",
        "path": "first_mode",
        "values": [
          "behavior",
          "behavior mode"
        ]
      },
      {
        "type": "contains_any",
        "values": [
          "fail",
          "red",
          "regression test",
          "new expectation"
        ]
      },
      {
        "type": "json_in",
        "path": "second_mode",
        "values": [
          "refactoring",
          "refactoring mode"
        ]
      },
      {
        "type": "json_equals",
        "path": "green_between_modes",
        "value": true
      },
      {
        "type": "contains_any",
        "values": [
          "observable",
          "documented",
          "contract",
          "behavior change"
        ]
      }
    ],
    "split": "held-out",
    "kind": "outcome"
  },
  {
