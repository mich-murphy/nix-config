  {
    "id": "semantic-model-routing",
    "prompt": "Route three tasks: A) deterministic private-symbol rename with compiler checks; B) bounded local refactor with reliable tests; C) cross-service public API redesign with migration and data-loss risk. Return only JSON with objects `A`, `B`, and `C`; each must contain `lane` and `effort`. Use lane values `efficient`, `balanced`, or `frontier`, and effort values `low`, `medium`, `high`, or `xhigh`.",
    "references": [
      "model-routing.md"
    ],
    "assertions": [
      {
        "type": "json_equals",
        "path": "A.lane",
        "value": "efficient"
      },
      {
        "type": "json_equals",
        "path": "A.effort",
        "value": "low"
      },
      {
        "type": "json_equals",
        "path": "B.lane",
        "value": "balanced"
      },
      {
        "type": "json_equals",
        "path": "B.effort",
        "value": "medium"
      },
      {
        "type": "json_equals",
        "path": "C.lane",
        "value": "frontier"
      },
      {
        "type": "contains_any",
        "values": [
          "high",
          "xhigh"
        ]
      }
    ],
    "split": "development",
    "kind": "outcome"
  }
