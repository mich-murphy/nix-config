{
  "schema_version": "1.0.0",
  "semantic_lane": "balanced",
  "default_effort": "medium",
  "escalation_conditions": [
    "ambiguous container or acceptance decision",
    "security, data-loss, or release-critical review",
    "a balanced-lane verifier gap"
  ],
  "harnesses": {
    "codex": {"model": "gpt-5.6-terra", "effort": "medium"},
    "claude": {"model": "sonnet", "effort": "medium"},
    "pi": {"model": "anthropic/claude-sonnet-4-6", "effort": "medium"}
  },
  "variants": ["no-skill", "incumbent", "candidate"],
  "fixed": ["task", "model", "effort", "tools", "permissions", "timeout", "workspace", "verifier"],
  "comparison_gate": {
    "minimum_candidate_score": 0.8,
    "minimum_score_gain_over_incumbent": 0.1,
    "blocking_regressions_allowed": 0
  }
}
