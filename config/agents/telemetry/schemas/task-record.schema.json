{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.elmurphy.com/schemas/app-agent-task-1.0.0.json",
  "title": "Application agent task record",
  "type": "object",
  "required": [
    "app.agent.schema.version",
    "app.agent.record.type",
    "app.agent.task.id",
    "app.agent.harness.name",
    "app.agent.harness.version",
    "app.agent.repository.hash",
    "app.agent.repository.base_revision",
    "app.agent.task.class",
    "app.agent.risk.class",
    "app.agent.skill.catalogue_hash",
    "app.agent.final.status"
  ],
  "properties": {
    "app.agent.schema.version": {"const": "1.0.0"},
    "app.agent.record.type": {
      "enum": ["task", "skill", "tool", "permission", "validation", "outcome"]
    },
    "app.agent.task.id": {"type": "string", "minLength": 8},
    "app.agent.session.id": {"type": "string"},
    "app.agent.parent.task_id": {"type": "string"},
    "app.agent.harness.name": {"enum": ["codex", "claude", "pi"]},
    "app.agent.harness.version": {"type": "string"},
    "app.agent.repository.hash": {"type": "string"},
    "app.agent.repository.base_revision": {"type": "string"},
    "app.agent.task.class": {"type": "string"},
    "app.agent.risk.class": {"type": "string"},
    "app.agent.skill.catalogue_hash": {"type": "string"},
    "app.agent.collector.version": {"type": "string"},
    "app.agent.model.lane": {"enum": ["efficient", "balanced", "frontier", "not_observed"]},
    "app.agent.model.effort": {"enum": ["low", "medium", "high", "xhigh", "not_observed"]},
    "app.agent.model.requested": {"type": "string"},
    "app.agent.model.returned": {"type": "string"},
    "app.agent.skill.name": {"type": "string"},
    "app.agent.skill.package_hash": {"type": "string"},
    "app.agent.skill.selection": {"enum": ["user", "router", "model", "nested", "none"]},
    "app.agent.skill.activation": {"enum": ["offered", "selected", "activated", "expanded", "executed", "not_observed"]},
    "app.agent.skill.trigger": {"type": "string"},
    "app.agent.skill.resource.class": {"enum": ["catalogue", "instructions", "reference", "script", "asset", "not_observed"]},
    "app.agent.tool.type": {"enum": ["shell", "filesystem", "search", "network", "mcp", "validation", "other"]},
    "app.agent.tool.status": {"enum": ["ok", "error", "denied", "cancelled", "not_observed"]},
    "app.agent.permission.decision": {"enum": ["allowed", "denied", "cancelled", "not_observed"]},
    "app.agent.permission.policy": {"type": "string"},
    "app.agent.validation.type": {"type": "string"},
    "app.agent.validation.status": {"enum": ["pass", "fail", "defer", "not_observed", "evaluator_error"]},
    "app.agent.validation.passed": {"type": "integer", "minimum": 0},
    "app.agent.validation.failed": {"type": "integer", "minimum": 0},
    "app.agent.validation.skipped": {"type": "integer", "minimum": 0},
    "app.agent.retry.count": {"type": "integer", "minimum": 0},
    "app.agent.tokens.input": {"type": "integer", "minimum": 0},
    "app.agent.tokens.output": {"type": "integer", "minimum": 0},
    "app.agent.tokens.cached": {"type": "integer", "minimum": 0},
    "app.agent.tokens.reasoning": {"type": "integer", "minimum": 0},
    "app.agent.duration_ms": {"type": "number", "minimum": 0},
    "app.agent.time_to_first_output_ms": {"type": "number", "minimum": 0},
    "app.agent.permission_wait_ms": {"type": "number", "minimum": 0},
    "app.agent.human_rework_minutes": {"type": "number", "minimum": 0},
    "app.agent.outcome.status": {"type": "string"},
    "app.agent.outcome.reference": {"type": "string"},
    "app.agent.final.status": {"enum": ["accepted", "failed", "cancelled", "invalid_harness", "invalid_environment", "telemetry_error", "evaluator_error", "not_observed"]}
  },
  "additionalProperties": true
}
