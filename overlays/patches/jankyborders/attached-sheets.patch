diff --git a/src/events.c b/src/events.c
index 2ed4b02..ea24ca6 100644
--- a/src/events.c
+++ b/src/events.c
@@ -50,10 +50,24 @@ static void window_spawn_handler(uint32_t event, struct window_spawn_data* data,
     if (windows_window_create(windows, wid, sid)) {
       debug("Window Created: %d %d\n", wid, sid);
       windows_determine_and_focus_active_window(windows);
+    } else {
+      // A sheet or panel attached to a bordered window: reorder the parent's
+      // border below it once it is shown.
+      uint32_t parent_wid = window_parent(cid, wid);
+      if (parent_wid && table_find(windows, &parent_wid)) {
+        debug("Child Window Created: %d (parent %d)\n", wid, parent_wid);
+        DELAY_ASYNC_EXEC_ON_MAIN_THREAD(50000, {
+          windows_window_update(windows, parent_wid);
+        });
+      }
     }
   } else if (event == EVENT_WINDOW_DESTROY) {
     if (windows_window_destroy(windows, wid, sid)) {
       debug("Window Destroyed: %d %d\n", wid, sid);
+    } else {
+      DELAY_ASYNC_EXEC_ON_MAIN_THREAD(50000, {
+        windows_child_destroyed(windows, wid);
+      });
     }
     windows_determine_and_focus_active_window(windows);
   }
diff --git a/src/misc/extern.h b/src/misc/extern.h
index b41137b..bffef89 100644
--- a/src/misc/extern.h
+++ b/src/misc/extern.h
@@ -69,6 +69,7 @@ extern CFTypeRef SLSWindowQueryResultCopyWindows(CFTypeRef window_query);
 extern int SLSWindowIteratorGetCount(CFTypeRef iterator);
 extern bool SLSWindowIteratorAdvance(CFTypeRef iterator);
 extern uint32_t SLSWindowIteratorGetParentID(CFTypeRef iterator);
+extern CFArrayRef SLSCopyAssociatedWindows(int cid, uint32_t wid);
 extern uint32_t SLSWindowIteratorGetWindowID(CFTypeRef iterator);
 extern uint64_t SLSWindowIteratorGetTags(CFTypeRef iterator);
 extern uint64_t SLSWindowIteratorGetAttributes(CFTypeRef iterator);
diff --git a/src/misc/window.h b/src/misc/window.h
index c85c99a..67e5f3a 100644
--- a/src/misc/window.h
+++ b/src/misc/window.h
@@ -255,6 +255,57 @@ static inline int window_level(int cid, uint32_t wid) {
   return level;
 }
 
+// Returns the window `wid` is attached to, such as the document window of a
+// sheet, or 0 for a root window.
+static inline uint32_t window_parent(int cid, uint32_t wid) {
+  uint32_t parent = 0;
+  CFArrayRef window_ref = cfarray_of_cfnumbers(&wid,
+                                               sizeof(uint32_t),
+                                               1,
+                                               kCFNumberSInt32Type);
+  CFTypeRef query = SLSWindowQueryWindows(cid, window_ref, 0x0);
+  if (query) {
+    CFTypeRef iterator = SLSWindowQueryResultCopyWindows(query);
+    if (iterator && SLSWindowIteratorAdvance(iterator)) {
+      parent = SLSWindowIteratorGetParentID(iterator);
+    }
+    if (iterator) CFRelease(iterator);
+    CFRelease(query);
+  }
+  CFRelease(window_ref);
+  return parent;
+}
+
+// Returns the backmost window attached to `wid`, such as a sheet or an open
+// panel, or 0 when it has none. WindowServer keeps attached windows ordered
+// with their parent, so a border ordered above the parent lands above them
+// too. SLSCopyAssociatedWindows lists the windows front to back.
+static inline uint32_t window_lowest_child(int cid, uint32_t wid) {
+  uint32_t child = 0;
+  CFArrayRef associated = SLSCopyAssociatedWindows(cid, wid);
+  if (!associated) return 0;
+
+  if (CFArrayGetCount(associated) > 1) {
+    CFTypeRef query = SLSWindowQueryWindows(cid, associated, 0x0);
+    if (query) {
+      CFTypeRef iterator = SLSWindowQueryResultCopyWindows(query);
+      if (iterator) {
+        while (SLSWindowIteratorAdvance(iterator)) {
+          if (SLSWindowIteratorGetParentID(iterator) != wid) continue;
+          uint32_t candidate = SLSWindowIteratorGetWindowID(iterator);
+          bool shown = false;
+          SLSWindowIsOrderedIn(cid, candidate, &shown);
+          if (shown) child = candidate;
+        }
+        CFRelease(iterator);
+      }
+      CFRelease(query);
+    }
+  }
+  CFRelease(associated);
+  return child;
+}
+
 static inline void window_send_to_space(int cid, uint32_t wid, uint32_t sid) {
   CFArrayRef window_list = cfarray_of_cfnumbers(&wid,
                                                 sizeof(uint32_t),
diff --git a/src/windows.c b/src/windows.c
index 7822b50..764c908 100644
--- a/src/windows.c
+++ b/src/windows.c
@@ -191,6 +191,22 @@ static bool windows_window_focus(struct table* windows, uint32_t wid) {
   return found_window;
 }
 
+// A sheet or panel that a border was ordered below has gone: order the
+// border above its target again.
+void windows_child_destroyed(struct table* windows, uint32_t wid) {
+  for (int i = 0; i < windows->capacity; ++i) {
+    struct bucket* bucket = windows->buckets[i];
+    while (bucket) {
+      struct border* border = bucket->value;
+      if (border && border->child_wid == wid) {
+        border->child_wid = 0;
+        border_update(border, true);
+      }
+      bucket = bucket->next;
+    }
+  }
+}
+
 void windows_window_move(struct table* windows, uint32_t wid) {
   struct border* border = table_find(windows, &wid);
   if (border) border_move(border);
diff --git a/src/windows.h b/src/windows.h
index c77709a..31be5d0 100644
--- a/src/windows.h
+++ b/src/windows.h
@@ -9,6 +9,7 @@ void windows_update_all(struct table* windows);
 void windows_update_notifications(struct table* windows);
 
 void windows_hide_all(struct table* windows);
+void windows_child_destroyed(struct table* windows, uint32_t wid);
 void windows_window_update(struct table* windows, uint32_t wid);
 void windows_window_hide(struct table* windows, uint32_t wid);
 void windows_window_unhide(struct table* windows, uint32_t wid);
