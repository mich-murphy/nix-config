From 6675bbfff01cf76f2fb2a6f3b8baf1f98411ab9d Mon Sep 17 00:00:00 2001
From: mich-murphy <github@elmurphy.com>
Date: Mon, 16 Nov 2026 17:46:42 +1100
Subject: [PATCH] order borders below attached sheets and panels

WindowServer keeps a sheet or open panel ordered with its parent window,
so a border ordered above the parent also lands above the sheet. Order the
border below the parent's backmost attached window instead, and order it
above the parent again once that window is destroyed.
---
 src/border.c      | 27 +++++++++++++++++--------
 src/border.h      |  2 ++
 src/events.c      | 14 +++++++++++++
 src/misc/extern.h |  1 +
 src/misc/window.h | 51 +++++++++++++++++++++++++++++++++++++++++++++++
 src/windows.c     | 16 +++++++++++++++
 src/windows.h     |  1 +
 7 files changed, 104 insertions(+), 8 deletions(-)

diff --git a/src/border.c b/src/border.c
index f2b57e9..0d4f8ab 100644
--- a/src/border.c
+++ b/src/border.c
@@ -96,6 +96,23 @@ static struct corner_radii border_target_corner_radii(struct border* border, CGR
   return border_window_corner_radii(border, window_frame);
 }
 
+// Orders the border relative to its target. A border drawn above the target
+// goes below the target's attached windows instead, so sheets and open panels
+// stay on top of it.
+static void border_order_window(struct border* border, CFTypeRef transaction, int order) {
+  uint32_t relative_wid = border->target_wid;
+  border->child_wid = 0;
+  if (order == BORDER_ORDER_ABOVE && !border->is_proxy) {
+    uint32_t child = window_lowest_child(border->cid, border->target_wid);
+    if (child) {
+      border->child_wid = child;
+      relative_wid = child;
+      order = BORDER_ORDER_BELOW;
+    }
+  }
+  SLSTransactionOrderWindow(transaction, border->wid, order, relative_wid);
+}
+
 struct settings* border_get_settings(struct border* border) {
   assert(pthread_main_np() != 0);
   return border->setting_override.enabled
@@ -332,10 +349,7 @@ void border_update_internal(struct border* border, struct settings* settings) {
   }
   SLSTransactionSetWindowLevel(transaction, border->wid, level);
   SLSTransactionSetWindowSubLevel(transaction, border->wid, sub_level);
-  SLSTransactionOrderWindow(transaction,
-                            border->wid,
-                            settings->border_order,
-                            border->target_wid      );
+  border_order_window(border, transaction, settings->border_order);
   SLSTransactionCommit(transaction, 0);
   CFRelease(transaction);
 
@@ -501,10 +515,7 @@ void border_unhide(struct border* border) {
     struct settings* settings = border_get_settings(border);
     CFTypeRef transaction = SLSTransactionCreate(border->cid);
     if (transaction) {
-      SLSTransactionOrderWindow(transaction,
-                                border->wid,
-                                settings->border_order,
-                                border->target_wid      );
+      border_order_window(border, transaction, settings->border_order);
       SLSTransactionCommit(transaction, 0);
       CFRelease(transaction);
     }
diff --git a/src/border.h b/src/border.h
index fc20ee6..653c441 100644
--- a/src/border.h
+++ b/src/border.h
@@ -70,6 +70,8 @@ struct border {
   uint64_t sid;
   uint32_t wid;
   uint32_t target_wid;
+  // The attached window the border is ordered below, if any.
+  uint32_t child_wid;
 
   float radius;
