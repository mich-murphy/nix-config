 extern struct settings g_settings;
 
+// Loaded via dlsym in main.c
+extern CGError (*JBSLSDisplayGetCornerRadii)(uint32_t, double*, double*, double*, double*);
+
+// Returns the corner radius of the display that holds most of the window and
+// writes its bounds to `display_bounds`. Returns 0 when the display has square
+// corners or the radius is unavailable.
+static float border_display_corner_radius(CGRect window_frame, CGRect* display_bounds) {
+  if (!JBSLSDisplayGetCornerRadii) return 0.f;
+
+  uint32_t display_ids[16];
+  uint32_t count = 0;
+  if (CGGetActiveDisplayList(16, display_ids, &count) != kCGErrorSuccess) {
+    return 0.f;
+  }
+
+  uint32_t display_id = 0;
+  CGFloat max_area = 0;
+  for (uint32_t i = 0; i < count; i++) {
+    CGRect bounds = CGDisplayBounds(display_ids[i]);
+    CGRect overlap = CGRectIntersection(bounds, window_frame);
+    CGFloat area = overlap.size.width * overlap.size.height;
+    if (!CGRectIsNull(overlap) && area > max_area) {
+      max_area = area;
+      display_id = display_ids[i];
+      *display_bounds = bounds;
+    }
+  }
+  if (!display_id) return 0.f;
+
+  double radii[4] = { 0, 0, 0, 0 };
+  if (JBSLSDisplayGetCornerRadii(display_id,
+                                 &radii[0],
+                                 &radii[1],
+                                 &radii[2],
+                                 &radii[3]  ) != kCGErrorSuccess) {
+    return 0.f;
+  }
+  return fmax(fmax(radii[0], radii[1]), fmax(radii[2], radii[3]));
+}
+
+// On displays with rounded corners, AppKit widens the bottom corners of a
+// window as they approach the display corners, so that both curves line up
+// (see -[NSThemeFrame _adjustedCornerRadii:]). WindowServer does not report
+// these radii, so apply the same rule here.
+static struct corner_radii border_window_corner_radii(struct border* border, CGRect window_frame) {
+  float radius = border->radius;
+  struct corner_radii radii = corner_radii_uniform(radius);
+
+  CGRect display_bounds;
+  float display_radius = border_display_corner_radius(window_frame,
+                                                      &display_bounds);
+  if (display_radius <= 0.f) return radii;
+
+  // Window bounds use a top-left origin, so the bottom edge is at max y.
+  float bottom = 1.f - fabs(CGRectGetMaxY(window_frame)
+                            - CGRectGetMaxY(display_bounds)) / display_radius;
+  float left = 1.f - fabs(CGRectGetMinX(window_frame)
+                          - CGRectGetMinX(display_bounds)) / display_radius;
+  float right = 1.f - fabs(CGRectGetMaxX(window_frame)
+                           - CGRectGetMaxX(display_bounds)) / display_radius;
+
+  float t_left = fminf(left, bottom);
+  float t_right = fminf(right, bottom);
+  if (t_left > 0.f) {
+    radii.bottom_left = radius + t_left * (display_radius - radius);
+  }
+  if (t_right > 0.f) {
+    radii.bottom_right = radius + t_right * (display_radius - radius);
+  }
+  return radii;
+}
+
+// Refreshes the base radius of the target window and returns the radii its
+// border should follow. WindowServer reports no uniform radius exactly when
+// the corners differ, so only then follow the display corners. Windows that
+// keep uniform corners near the display edge are left untouched.
+static struct corner_radii border_target_corner_radii(struct border* border, CGRect window_frame) {
+  float radius = window_corner_radius(border->cid, border->target_wid);
+  if (radius > 0.f) {
+    if (radius != border->radius) {
+      border->radius = radius;
+      border->inner_radius = radius + 1;
+    }
+    return corner_radii_uniform(radius);
+  }
+  return border_window_corner_radii(border, window_frame);
+}
+
