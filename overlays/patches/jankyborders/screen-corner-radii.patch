@@ -115,7 +207,10 @@ static void border_draw(struct border* border, CGRect frame, struct settings* se
                                               -settings->border_width / 2.f);
     }
   } else {
-    float corner_radius = settings->border_style == BORDER_STYLE_ROUND_UNIFORM ? 9.0 : border->radius;
+    struct corner_radii corner_radius
