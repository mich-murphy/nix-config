diff --git a/src/misc/drawing.h b/src/misc/drawing.h
index e98394b..5783b6c 100644
--- a/src/misc/drawing.h
+++ b/src/misc/drawing.h
@@ -1,5 +1,31 @@
 #pragma once
 #include <CoreGraphics/CoreGraphics.h>
+#include <math.h>
+
+struct corner_radii {
+  float top_left;
+  float top_right;
+  float bottom_left;
+  float bottom_right;
+};
+
+static inline struct corner_radii corner_radii_uniform(float radius) {
+  return (struct corner_radii){ radius, radius, radius, radius };
+}
+
+static inline struct corner_radii corner_radii_outset(struct corner_radii radii, float outset) {
+  return (struct corner_radii){ radii.top_left + outset,
+                                radii.top_right + outset,
+                                radii.bottom_left + outset,
+                                radii.bottom_right + outset };
+}
+
+static inline bool corner_radii_equal(struct corner_radii a, struct corner_radii b) {
+  return a.top_left == b.top_left
+         && a.top_right == b.top_right
+         && a.bottom_left == b.bottom_left
+         && a.bottom_right == b.bottom_right;
+}
 
 struct gradient {
   enum { TL_TO_BR, TR_TO_BL } direction;
@@ -55,12 +81,34 @@ static inline void drawing_add_rect_with_inset(CGContextRef context, CGRect rect
   CFRelease(square_path);
 }
 
-static inline void drawing_add_rounded_rect(CGContextRef context, CGRect rect, float border_radius) {
-  CGPathRef stroke_path = CGPathCreateWithRoundedRect(rect,
-                                                      border_radius,
-                                                      border_radius,
-                                                      NULL          );
+static inline float drawing_clamp_radius(float radius, CGRect rect) {
+  float max_radius = fminf(rect.size.width, rect.size.height) / 2.f;
+  return fmaxf(0.f, fminf(radius, max_radius));
+}
 
+// The border context is not flipped, so the bottom corners are at min y.
+static inline void drawing_path_add_rounded_rect(CGMutablePathRef path, CGRect rect, struct corner_radii radii) {
+  float tl = drawing_clamp_radius(radii.top_left, rect);
+  float tr = drawing_clamp_radius(radii.top_right, rect);
+  float bl = drawing_clamp_radius(radii.bottom_left, rect);
+  float br = drawing_clamp_radius(radii.bottom_right, rect);
+
+  CGFloat min_x = CGRectGetMinX(rect);
+  CGFloat max_x = CGRectGetMaxX(rect);
+  CGFloat min_y = CGRectGetMinY(rect);
+  CGFloat max_y = CGRectGetMaxY(rect);
+
+  CGPathMoveToPoint(path, NULL, min_x + bl, min_y);
+  CGPathAddArcToPoint(path, NULL, max_x, min_y, max_x, min_y + br, br);
+  CGPathAddArcToPoint(path, NULL, max_x, max_y, max_x - tr, max_y, tr);
+  CGPathAddArcToPoint(path, NULL, min_x, max_y, min_x, max_y - tl, tl);
+  CGPathAddArcToPoint(path, NULL, min_x, min_y, min_x + bl, min_y, bl);
+  CGPathCloseSubpath(path);
+}
+
+static inline void drawing_add_rounded_rect(CGContextRef context, CGRect rect, struct corner_radii radii) {
+  CGMutablePathRef stroke_path = CGPathCreateMutable();
+  drawing_path_add_rounded_rect(stroke_path, rect, radii);
   CGContextAddPath(context, stroke_path);
   CFRelease(stroke_path);
 }
@@ -76,14 +124,14 @@ static inline void drawing_draw_square_gradient_with_inset(CGContextRef context,
   CGContextDrawLinearGradient(context, gradient, dir[0], dir[1], 0);
 }
 
-static inline void drawing_draw_rounded_rect_with_inset(CGContextRef context, CGRect rect, float border_radius, bool fill) {
-  drawing_add_rounded_rect(context, rect, border_radius);
+static inline void drawing_draw_rounded_rect_with_inset(CGContextRef context, CGRect rect, struct corner_radii radii, bool fill) {
+  drawing_add_rounded_rect(context, rect, radii);
   if (fill) CGContextFillPath(context);
   else CGContextStrokePath(context);
 }
 
-static inline void drawing_draw_rounded_gradient_with_inset(CGContextRef context,CGGradientRef gradient, CGPoint dir[2], CGRect rect, float border_radius) {
-  drawing_add_rounded_rect(context, rect, border_radius);
+static inline void drawing_draw_rounded_gradient_with_inset(CGContextRef context,CGGradientRef gradient, CGPoint dir[2], CGRect rect, struct corner_radii radii) {
+  drawing_add_rounded_rect(context, rect, radii);
   CGContextReplacePathWithStrokedPath(context);
   CGContextClip(context);
   CGContextDrawLinearGradient(context, gradient, dir[0], dir[1], 0);
