 crates/plannotator-tui/src/app/draw.rs    | 4 ++--
 crates/plannotator-tui/src/config.rs      | 8 ++++++++
 crates/plannotator-tui/src/layout.rs      | 3 +++
 crates/plannotator-tui/src/review/rail.rs | 2 +-
 crates/plannotator-tui/src/theme.rs       | 9 +++++++++
 6 files changed, 24 insertions(+), 3 deletions(-)

diff --git a/README.md b/README.md
index 3fbba96..e3b2154 100644
--- a/README.md
+++ b/README.md
@@ -286,6 +286,7 @@ # ~/.config/plannotator-tui/config.toml
 code-block = "light-yellow"  # fenced and indented code
 link = "blue"            # links, always underlined
 quote = "green"          # block quotes, always italic
+border = "dark-gray"     # table borders, unfocused note bubbles and the tree divider
 ```
 
