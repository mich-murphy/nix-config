+/// One block's source to styled text. Without a code theme, fences lose their language first,
+/// so nothing is highlighted (see `code_theme`).
+fn render(source: &str, options: &Options<Styles>) -> Text<'static> {
+    let source = if options.selected_code_theme().is_some() {
+        Cow::Borrowed(source)
+    } else {
+        without_languages(source)
+    };
+    let protected = protect(&source);
+    let text = own(tui_markdown::from_str_with_options(&protected, options));
+    if matches!(protected, Cow::Owned(_)) { strip_marks(text) } else { text }
+}
+
 fn render_block(doc: &Document, index: usize) -> Decorated {
+    render_block_with(doc, index, code_theme::options())
+}
+
+fn render_block_with(doc: &Document, index: usize, options: &Options<Styles>) -> Decorated {
     let source = doc.block_text(index);
-    let protected = protect(source);
-    let text = own(tui_markdown::from_str_with_options(&protected, &Options::new(Styles)));
-    let mut text = if matches!(protected, Cow::Owned(_)) { strip_marks(text) } else { text };
+    let mut text = render(source, options);
+    // `tui-markdown` omits a line it fails to highlight. Rendered, a code block has at least
+    // as many lines as its source, so fewer means a line went missing: render it plain.
+    if options.selected_code_theme().is_some()
+        && doc.blocks.get(index).is_some_and(|b| b.kind == BlockKind::CodeBlock)
+        && text.lines.len() < source.lines().count()
+    {
+        text = render(&without_languages(source), options);
+    }
     let plain: Vec<String> = text.lines.iter().map(ToString::to_string).collect();
     let block = doc.blocks.get(index);
     let base = block.map_or(0, |b| b.range.start);
@@ -249,6 +274,53 @@ fn code_blocks_take_the_code_block_role_and_inline_code_keeps_the_code_role() {
         assert_eq!(span.style.fg, Some(palette().code));
     }
 
+    fn themed() -> Options<Styles> {
+        Options::new(Styles).code_theme(tui_markdown::BuiltinCodeTheme::Base16OceanDark)
+    }
+
+    fn is_highlighted(text: &Text<'_>) -> bool {
+        let mut spans = text.lines.iter().flat_map(|l| &l.spans);
+        spans.any(|s| matches!(s.style.fg, Some(ratatui::style::Color::Rgb(..))))
+    }
+
+    #[test]
+    fn every_character_of_highlighted_code_maps_back_to_its_source() {
+        let doc = Document::parse("```rust\nfn main() {\n    let s = \"héllo\"; // hi\n}\n```\n".to_owned());
+        let Decorated { text, offsets, .. } = render_block_with(&doc, 0, &themed());
+        assert!(is_highlighted(&text), "{text:?}");
+        let mut checked = 0;
+        for (line, offsets) in text.lines.iter().zip(&offsets) {
+            let chars = line.spans.iter().flat_map(|s| s.content.chars());
+            for (ch, offset) in chars.zip(offsets).filter(|(ch, _)| !ch.is_whitespace()) {
+                let source = offset.and_then(|o| doc.source.get(o..));
+                assert!(source.is_some_and(|s| s.starts_with(ch)), "{ch:?} unmapped in {line}");
+                checked += 1;
+            }
+        }
+        assert!(checked > 30, "only {checked} characters checked");
+    }
+
+    #[test]
