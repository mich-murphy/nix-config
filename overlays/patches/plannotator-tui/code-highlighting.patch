diff --git a/crates/plannotator-tui/src/code_theme.rs b/crates/plannotator-tui/src/code_theme.rs
new file mode 100644
index 0000000..c011125
--- /dev/null
+++ b/crates/plannotator-tui/src/code_theme.rs
@@ -0,0 +1,122 @@
+//! Syntax highlighting for fenced code: the theme `[ui] code_theme` names, loaded once.
+//!
+//! `tui-markdown` highlights every fence whose language it recognizes, and falls back to a
+//! bundled theme of its own when it is given none. So with no `code_theme` set, each fence's
+//! info string is cut before rendering ([`without_languages`]): no language is found and code
+//! renders plain, as it did before highlighting was compiled in. The rendering options live
+//! here, built once, so no block clones the theme.
+
+use std::borrow::Cow;
+use std::path::{Path, PathBuf};
+use std::sync::OnceLock;
+
+use anyhow::Result;
+use pulldown_cmark::{CodeBlockKind, Event, Parser, Tag};
+use tui_markdown::{CodeTheme, Options};
+
+use crate::config::{Config, config_path};
+use crate::doc::parse_options;
+use crate::layout::Styles;
+
+static OPTIONS: OnceLock<Options<Styles>> = OnceLock::new();
+
+/// The options every block renders with: no code theme until [`install`] loads one, which
+/// is what tests and a config without `code_theme` get.
+pub(crate) fn options() -> &'static Options<Styles> {
+    OPTIONS.get_or_init(|| Options::new(Styles))
+}
+
+/// Load the configured theme, if any, and fix it for this process. The first call wins.
+pub(crate) fn install(config: &Config) -> Result<()> {
+    let options = match load(config)? {
+        Some(theme) => Options::new(Styles).code_theme(theme),
+        None => Options::new(Styles),
+    };
+    let _ = OPTIONS.set(options);
+    Ok(())
+}
+
+/// The theme `[ui] code_theme` names, read from disk; `None` when it is not set.
+pub(crate) fn load(config: &Config) -> Result<Option<CodeTheme>> {
+    let home = std::env::home_dir().unwrap_or_else(|| PathBuf::from("/"));
+    let file = config_path(|key| std::env::var(key).ok(), &home);
+    load_from(config.ui.code_theme.as_deref(), &file, &home)
+}
+
+fn load_from(setting: Option<&str>, config_file: &Path, home: &Path) -> Result<Option<CodeTheme>> {
+    let Some(setting) = setting else { return Ok(None) };
+    let path = resolve(setting, config_file, home);
+    CodeTheme::from_file(&path).map(Some).map_err(|err| anyhow::anyhow!("[ui] code_theme: {err}"))
+}
+
+/// `~/` is the home folder; any other relative path is read from the config file's folder.
+fn resolve(setting: &str, config_file: &Path, home: &Path) -> PathBuf {
+    if let Some(rest) = setting.strip_prefix("~/").or_else(|| setting.strip_prefix("~\\")) {
+        return home.join(rest);
+    }
+    config_file.parent().unwrap_or_else(|| Path::new("")).join(setting)
+}
+
+/// `source` with every fence's info string cut, so `tui-markdown` finds no language to
+/// highlight. Offsets are unaffected: alignment runs against the original source.
+pub(crate) fn without_languages(source: &str) -> Cow<'_, str> {
+    if !source.contains("```") && !source.contains("~~~") {
+        return Cow::Borrowed(source);
+    }
+    let mut cuts = Vec::new();
+    for (event, range) in Parser::new_ext(source, parse_options()).into_offset_iter() {
+        let Event::Start(Tag::CodeBlock(CodeBlockKind::Fenced(info))) = event else { continue };
+        let line = source.get(range.start..).and_then(|s| s.lines().next()).unwrap_or_default();
+        let Some(fence) = line.find(['`', '~']).filter(|_| !info.is_empty()) else { continue };
+        let rest = line.get(fence..).unwrap_or_default();
+        let mark = rest.chars().next().unwrap_or('`');
+        let info_at = fence + rest.len() - rest.trim_start_matches(mark).len();
+        cuts.push(range.start + info_at..range.start + line.len());
+    }
+    if cuts.is_empty() {
+        return Cow::Borrowed(source);
+    }
+    let mut out = String::with_capacity(source.len());
+    let mut at = 0;
+    for cut in cuts {
+        out.push_str(source.get(at..cut.start).unwrap_or_default());
+        at = cut.end;
+    }
+    out.push_str(source.get(at..).unwrap_or_default());
+    Cow::Owned(out)
+}
+
+#[cfg(test)]
+#[allow(clippy::expect_used, reason = "tests assert by panicking")]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn a_relative_theme_is_read_from_the_config_folder_and_tilde_from_home() {
+        let (file, home) = (Path::new("/etc/pt/config.toml"), Path::new("/home/u"));
+        assert_eq!(resolve("night.tmTheme", file, home), PathBuf::from("/etc/pt/night.tmTheme"));
+        assert_eq!(resolve("~/t/night.tmTheme", file, home), PathBuf::from("/home/u/t/night.tmTheme"));
+        assert_eq!(resolve("/abs/night.tmTheme", file, home), PathBuf::from("/abs/night.tmTheme"));
+    }
+
+    #[test]
+    fn a_missing_or_invalid_theme_is_an_error_naming_the_file() {
+        let dir = std::env::temp_dir().join(format!("plannotator code-theme-{}", std::process::id()));
+        std::fs::create_dir_all(&dir).expect("temp dir");
+        std::fs::write(dir.join("broken.tmTheme"), "not a plist").expect("written");
+        let config = dir.join("config.toml");
+        for name in ["missing.tmTheme", "broken.tmTheme"] {
+            let err = load_from(Some(name), &config, &dir).expect_err("rejected");
+            assert!(err.to_string().contains(name), "{err}");
+        }
+        std::fs::remove_dir_all(&dir).expect("cleaned up");
+    }
+
+    #[test]
+    fn languages_are_cut_from_fences_and_nothing_else() {
+        let source = "- item\n\n  ```rust title\n  let x = `y`;\n  ```\n\n~~~ py\nz\n~~~";
+        let expected = "- item\n\n  ```\n  let x = `y`;\n  ```\n\n~~~\nz\n~~~";
+        assert_eq!(without_languages(source), expected);
+        assert!(matches!(without_languages("```\nplain\n```"), Cow::Borrowed(_)));
+    }
+}
