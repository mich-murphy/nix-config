+/// Code-block lines take the `code-block` role, decided by the parse rather than by how the
+/// renderer styled them: inline code keeps `code` on its own span, so only a line whose text
+/// falls inside one of the `code` source ranges is repainted.
+fn paint_code_lines(text: &mut Text<'static>, offsets: &[LineOffsets], code: &[Range<usize>]) {
+    let style = Style::new().fg(palette().code_block);
+    for (line, offsets) in text.lines.iter_mut().zip(offsets) {
+        if offsets.iter().flatten().any(|offset| code.iter().any(|range| range.contains(offset))) {
+            line.style = style;
+        }
     }
 }
 
