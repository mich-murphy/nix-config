index 0000000..d8c7e08
--- /dev/null
+++ b/crates/plannotator-tui/src/diagram.rs
@@ -0,0 +1,93 @@
+//! Fenced `mermaid` blocks drawn as box-drawing text by `boxmaid` (decision 20).
+//!
+//! A diagram is drawn once, at the width the layout is built for, and clipped like code on a
+//! later resize. Its glyphs have no source characters, so every cell maps to the block's
+//! first byte: a note on the block highlights the drawing, and a drag in it widens to the
+//! whole block (`App::finish_selection`). Anything `boxmaid` cannot draw shows its source.
+
+use std::sync::OnceLock;
+
+use ratatui::style::Style;
+use ratatui::text::{Line, Text};
+
+use crate::decorate::Decorated;
+use crate::theme::palette;
+
+static ENABLED: OnceLock<bool> = OnceLock::new();
+
+/// `[ui] mermaid`: on until [`install`] says otherwise.
+pub(crate) fn enabled() -> bool {
+    ENABLED.get().copied().unwrap_or(true)
+}
+
+/// Fix `[ui] mermaid` for this process. The first call wins.
+pub(crate) fn install(on: bool) {
+    let _ = ENABLED.set(on);
+}
+
+/// The fenced block `source`, starting at absolute byte `start`, drawn `width` columns wide;
+/// `None` when it does not parse or draws nothing, so the caller shows it as code.
+pub(crate) fn draw(source: &str, start: usize, width: usize) -> Option<Decorated> {
+    let mut body: Vec<&str> = source.lines().skip(1).collect();
+    if body.last().is_some_and(|line| line.trim_start().starts_with(['`', '~'])) {
+        body.pop();
+    }
+    let picture = boxmaid::render(&body.join("\n"), &boxmaid::Options { width, ascii: false }).ok()?;
+    let lines = picture.lines();
+    if lines.iter().all(String::is_empty) {
+        return None;
+    }
+    let style = Style::new().fg(palette().code_block);
+    let offsets = lines.iter().map(|line| vec![Some(start); line.chars().count()]).collect();
+    let text = Text::from(lines.into_iter().map(|line| Line::from(line).style(style)).collect::<Vec<_>>());
+    Some(Decorated { text, offsets, hangs: Vec::new() })
+}
+
+#[cfg(test)]
+#[allow(clippy::expect_used, reason = "tests assert by panicking")]
+mod tests {
+    use crate::doc::Document;
+    use crate::layout::DocLayout;
+
+    const FLOW: &str = "```mermaid\nflowchart LR\n  Draft --> Review --> Approve\n```\n";
+
+    fn rows(layout: &DocLayout) -> Vec<String> {
+        layout.blocks.iter().flat_map(|b| &b.rows).map(|r| r.line.to_string()).collect()
+    }
+
+    #[test]
+    fn a_mermaid_fence_is_drawn_in_box_drawing_mapped_to_its_block() {
+        let layout = DocLayout::build_with(&Document::parse(FLOW.to_owned()), 80, true);
+        assert!(layout.is_diagram(0));
+        let drawn = rows(&layout);
+        assert!(
+            drawn.iter().any(|r| r.contains('─')) && drawn.iter().all(|r| !r.contains("-->")),
+            "{drawn:?}"
+        );
+        let cells = layout.blocks.iter().flat_map(|b| &b.rows).flat_map(|r| &r.cells);
+        assert!(cells.copied().all(|c| c == Some(0)));
+    }
+
+    #[test]
+    fn mermaid_that_does_not_parse_shows_its_source() {
+        let doc = Document::parse("```mermaid\nthis is not mermaid\n```\n".to_owned());
+        let layout = DocLayout::build_with(&doc, 80, true);
+        assert!(!layout.is_diagram(0));
+        assert!(rows(&layout).iter().any(|r| r == "this is not mermaid"));
+    }
+
+    #[test]
+    fn with_mermaid_off_the_fence_shows_its_source() {
+        let layout = DocLayout::build_with(&Document::parse(FLOW.to_owned()), 80, false);
+        assert!(!layout.is_diagram(0));
+        assert!(rows(&layout).iter().any(|r| r == "flowchart LR"));
+    }
+
+    #[test]
+    fn diagram_rows_clip_at_the_width() {
+        let mut layout = DocLayout::build_with(&Document::parse(FLOW.to_owned()), 80, true);
+        assert!(rows(&layout).iter().any(|r| r.chars().count() > 12));
+        layout.reflow(12);
+        assert!(layout.blocks.iter().flat_map(|b| &b.rows).all(|r| r.cells.len() <= 12));
+    }
+}
